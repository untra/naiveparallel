{
  "name": "@untra/naiveparallel",
  "version": "0.1.0",
  "description": "🪒 Naive React parallel coordinates plot for Array<T> datasets — a compound component for interactive, large-volume, multi-dimensional data exploration",
  "keywords": [
    "react",
    "parallel-coordinates",
    "chart",
    "visualization",
    "dataviz",
    "compound-component"
  ],
  "homepage": "https://github.com/untra/naiveparallel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/untra/naiveparallel.git"
  },
  "bugs": {
    "url": "https://github.com/untra/naiveparallel/issues"
  },
  "license": "MIT",
  "author": "Samuel Volin <untra.sam@gmail.com>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/naiveparallel.cjs",
  "module": "./dist/naiveparallel.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/naiveparallel.js",
      "require": "./dist/naiveparallel.cjs"
    },
    "./styles.css": "./dist/naiveparallel.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run ci"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "d3-dsv": "^3.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.60.0",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8"
  }
}
